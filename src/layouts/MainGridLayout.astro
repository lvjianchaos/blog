---
import BackToTop from "@components/control/BackToTop.astro";
import MobileToc from "@components/control/MobileToc.astro";
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import SideBar from "@components/widget/SideBar.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import TOC from "../components/widget/TOC.astro";
import { siteConfig } from "../config";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
	postLayout?: boolean;
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
	postLayout = false,
} = Astro.props;
const hasBannerCredit =
	siteConfig.banner.enable && siteConfig.banner.credit.enable;
const hasBannerLink = !!siteConfig.banner.credit.url;

// The post layout drops the sidebar to make room for the table of contents.
const usePostLayout = postLayout && siteConfig.toc.enable;
// Posts without any heading have nothing to navigate, so they keep the same
// reading width but stay centered instead of leaving an empty column behind.
const hasTocItems = usePostLayout && headings.length > 0;

const mainPanelTop = siteConfig.banner.enable
	? `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
	: "5.5rem";
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle}>

<!-- Navbar -->
<slot slot="head" name="head"></slot>
<div id="top-row" class="z-50 pointer-events-none relative transition-all duration-700 max-w-[var(--page-width)] px-0 md:px-4 mx-auto" class:list={[""]}>
    <div id="navbar-wrapper" class="pointer-events-auto sticky top-0 transition-all">
        <Navbar></Navbar>
    </div>
</div>

<!-- Banner -->
{siteConfig.banner.enable && <div id="banner-wrapper" class={`absolute z-10 w-full transition duration-700 overflow-hidden`} style={`top: -${BANNER_HEIGHT_EXTEND}vh`}>
    <ImageWrapper id="banner" alt="Banner image of the blog" class:list={["object-cover h-full transition duration-700 opacity-0 scale-105"]}
                  src={siteConfig.banner.src} position={siteConfig.banner.position}
    >
    </ImageWrapper>
</div>}

<!-- Main content -->
<div class="absolute w-full z-30 pointer-events-none" style={`top: ${mainPanelTop}`}>
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="relative max-w-[var(--page-width)] mx-auto pointer-events-auto">
        <!--
            The grid lives inside the Swup container. A post page uses a different
            layout than the other pages (no sidebar, but a table of contents), and
            that difference has to be replaced together with the page content,
            otherwise the layout of the previous page would be kept.
        -->
        <main id="swup-container" class="transition-swup-fade">
            <div id="main-grid" class:list={[
                "transition duration-700 w-full left-0 right-0 grid grid-cols-[17.5rem_auto] grid-rows-[auto_1fr_auto] lg:grid-rows-[auto] mx-auto gap-4 px-0 md:px-4",
                // `overflow-hidden` keeps long lines (e.g. bare URLs) inside the
                // layout. It has to be released on large screens, otherwise the
                // element becomes the scroll container of the sticky TOC.
                "overflow-hidden lg:overflow-visible",
                usePostLayout
                    ? hasTocItems
                        ? "lg:grid-cols-[minmax(0,1fr)_15rem] xl:grid-cols-[minmax(0,1fr)_17.5rem]"
                        : "lg:grid-cols-[minmax(0,1fr)]"
                    : "",
                // Leave room for the fixed mobile table of contents bar
                hasTocItems
                    ? "pb-[calc(3.5rem+env(safe-area-inset-bottom))] lg:pb-0"
                    : "",
            ]}
            >
            <!-- Banner image credit -->
            {hasBannerCredit && <a href={siteConfig.banner.credit.url} id="banner-credit" target="_blank" rel="noopener" aria-label="Visit image source"
                                   class:list={["group onload-animation transition-all absolute flex justify-center items-center rounded-full " +
                                   "px-3 right-4 -top-[3.25rem] bg-black/60 hover:bg-black/70 h-9", {"hover:pr-9 active:bg-black/80": hasBannerLink}]}
            >
                <Icon class="text-white/75 text-[1.25rem] mr-1" name="material-symbols:copyright-outline-rounded" ></Icon>
                <div class="text-white/75 text-xs">{siteConfig.banner.credit.text}</div>
                <Icon class:list={["transition absolute text-[oklch(0.75_0.14_var(--hue))] right-4 text-[0.75rem] opacity-0",
                    {"group-hover:opacity-100": hasBannerLink}]}
                      name="fa6-solid:arrow-up-right-from-square">
                </Icon>
            </a>}


                {!usePostLayout && <SideBar class="mb-4 row-start-2 row-end-3 col-span-2 lg:row-start-1 lg:row-end-2 lg:col-span-1 lg:max-w-[17.5rem] onload-animation" headings={headings}></SideBar>}

                <div id="content-wrapper" class:list={[
                    "col-span-2 lg:col-span-1 onload-animation min-w-0 overflow-hidden",
                    usePostLayout && !hasTocItems
                        ? "lg:mx-auto lg:max-w-[calc(var(--page-width)-17.5rem-1rem)]"
                        : "",
                ]}>
                    <!-- the overflow-hidden here prevent long text break the layout-->
                    <!-- make id different from windows.swup global property -->
                    <slot></slot>
                    <div class="footer col-span-2 onload-animation hidden lg:block">
                        <Footer></Footer>
                    </div>
                </div>

                <!--
                    The table of contents lives inside the Swup container as well,
                    so it is replaced together with the page and disappears on its
                    own when navigating to a page without a table of contents.
                -->
                {hasTocItems && (
                    <aside id="toc-column" class="hidden lg:block lg:col-start-2 lg:row-start-1">
                        <div id="toc-inner-wrapper" class="card-base sticky top-[4.5rem] max-h-[calc(100vh-8rem)] overflow-y-auto overflow-x-hidden hide-scrollbar">
                            <div class="text-sm font-bold text-75 px-3 pt-3 pb-1">
                                {i18n(I18nKey.toc)}
                            </div>
                            <div id="toc" class="w-full transition-swup-fade">
                                <div class="h-1 w-full"></div>
                                <TOC headings={headings}></TOC>
                                <div class="h-3 w-full"></div>
                            </div>
                        </div>
                    </aside>
                )}

                <!-- Mobile table of contents, only shown on narrow screens -->
                {hasTocItems && <MobileToc headings={headings} enabled={hasTocItems}></MobileToc>}

                <div class="footer col-span-2 onload-animation block lg:hidden">
                    <Footer></Footer>
                </div>
            </div>
        </main>

        <BackToTop></BackToTop>
    </div>
</div>

<style>
    /*
        The native table of contents fades its edges with a mask, which is meant
        for the borderless version. The card brings its own boundary, so the
        mask is not needed here.
    */
    #toc-inner-wrapper {
        mask-image: none;
    }
</style>
</Layout>
