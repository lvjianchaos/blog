---
import { getEntry, render } from "astro:content";
import FriendCard from "@components/misc/FriendCard.astro";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import { friends } from "@/data/friends";

const applyPost = await getEntry("spec", "friends");
const ApplyContent = applyPost ? (await render(applyPost)).Content : null;
---

<MainGridLayout title={i18n(I18nKey.friends)} description={i18n(I18nKey.friends)}>
    <div class="flex flex-col gap-4">
        <!-- 友链列表 -->
        <div class="card-base z-10 p-4 md:p-5">
            <div class="flex items-center gap-2 px-1 pb-3 font-bold text-lg text-90">
                <Icon name="fa6-solid:user-group" class="text-[var(--primary)]"></Icon>
                <span>{i18n(I18nKey.friends)}</span>
                <span class="text-sm font-normal text-30">({friends.length})</span>
            </div>

            {friends.length > 0 ? (
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    {friends.map((friend) => <FriendCard {...friend} />)}
                </div>
            ) : (
                <div class="py-8 text-center text-50">{i18n(I18nKey.noFriends)}</div>
            )}
        </div>

        <!-- 申请友链说明（内容来自 src/content/spec/friends.md） -->
        {ApplyContent && (
            <div class="card-base z-10 px-8 py-6">
                <Markdown class="mt-2">
                    <ApplyContent />
                </Markdown>
            </div>
        )}
    </div>
</MainGridLayout>
