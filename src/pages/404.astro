---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { url } from "@utils/url-utils";
import { Icon } from "astro-icon/components";

const title = i18n(I18nKey.notFound);
const description = i18n(I18nKey.notFoundDesc);
---

<MainGridLayout title={title} description={description} noindex={true} noCanonical={true}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 w-full px-8 py-14 flex flex-col items-center text-center gap-3">
            <div class="text-[4.5rem] leading-none font-extrabold text-[var(--primary)] select-none">
                404
            </div>

            <h1 class="text-xl font-bold text-90">{title}</h1>

            <p class="text-50 max-w-md">{description}</p>

            <div class="flex flex-wrap items-center justify-center gap-3 mt-3">
                <a href={url("/")} class="btn-regular rounded-lg h-10 px-4 gap-2 text-sm">
                    <Icon name="material-symbols:home-outline-rounded" class="text-[1.25rem]"></Icon>
                    {i18n(I18nKey.home)}
                </a>
                <a href={url("/archive/")} class="btn-regular rounded-lg h-10 px-4 gap-2 text-sm">
                    <Icon name="material-symbols:archive-outline-rounded" class="text-[1.25rem]"></Icon>
                    {i18n(I18nKey.archive)}
                </a>
            </div>
        </div>
    </div>
</MainGridLayout>
