---
import { Icon } from "astro-icon/components";
import type { FriendLink } from "@/data/friends";

interface Props extends FriendLink {
	class?: string;
}

const { name, url, avatar, description, tags = [] } = Astro.props;
const className = Astro.props.class;
const fallbackInitial = name.trim().charAt(0).toUpperCase();
---

<a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={name}
    class:list={[
        "group relative flex items-center gap-3 p-3 rounded-[var(--radius-large)] overflow-hidden transition",
        "bg-[var(--btn-regular-bg)] hover:bg-[var(--btn-regular-bg-hover)] active:bg-[var(--btn-regular-bg-active)]",
        className,
    ]}
>
    <!-- avatar -->
    <div class="relative w-12 h-12 shrink-0 rounded-full overflow-hidden bg-[var(--primary)]/15 ring-2 ring-transparent
        group-hover:ring-[var(--primary)]/40 transition">
        <span class="absolute inset-0 flex items-center justify-center font-bold text-[var(--primary)] select-none">
            {fallbackInitial}
        </span>
        {avatar && (
            <img
                src={avatar}
                alt={`${name} avatar`}
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
                class="relative w-full h-full object-cover transition duration-300 group-hover:scale-110"
                onerror="this.style.display='none';"
            />
        )}
    </div>

    <!-- info -->
    <div class="min-w-0 flex-1">
        <div class="flex items-center gap-1.5 font-bold text-90 group-hover:text-[var(--primary)] transition">
            <span class="truncate">{name}</span>
            <Icon name="fa6-solid:arrow-up-right-from-square"
                  class="text-[0.6rem] text-30 shrink-0 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition"/>
        </div>
        <div class="mt-0.5 text-sm text-50 line-clamp-2 break-words">{description}</div>
        {tags.length > 0 && (
            <div class="mt-1.5 flex flex-wrap gap-1">
                {tags.map((tag) => (
                    <span class="px-1.5 py-0.5 rounded-md text-[0.7rem] text-50 bg-[var(--card-bg)] transition">{tag}</span>
                ))}
            </div>
        )}
    </div>
</a>
